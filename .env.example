# Required for management authentication in every deployed environment.
JWT_SECRET=replace-with-a-long-random-secret

# Required only when initializing a new database with no admin account.
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=replace-with-a-unique-strong-password

# Optional shared services.
# DATABASE_URL=postgresql://user:password@host:5432/database
# RAZORPAY_KEY_ID=rzp_test_xxx
# RAZORPAY_KEY_SECRET=xxx
# SMTP_HOST=smtp.example.com
# SMTP_USER=notifications@example.com
# SMTP_PASS=replace-with-provider-password

# Required when building a Capacitor Android/iOS app. This must be an API URL
# reachable by the device; Vite's relative /api proxy does not exist inside a
# packaged WebView. Use HTTPS for deployed builds.
# VITE_API_URL=https://api.example.com/api
# Do not expose RAZORPAY_KEY_SECRET or any provider secret via a VITE_* value.
