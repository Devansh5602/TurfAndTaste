# Required for management authentication in every deployed environment.
JWT_SECRET=replace-with-a-long-random-secret

# Required only when initializing a new database with no admin account.
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=replace-with-a-unique-strong-password

# Optional shared services.
# DATABASE_URL=postgresql://user:password@host:5432/database
# RAZORPAY_KEY_ID=rzp_live_xxx
# RAZORPAY_KEY_SECRET=xxx
# SMTP_HOST=smtp.example.com
# SMTP_USER=notifications@example.com
# SMTP_PASS=replace-with-provider-password
