{
  "appId": "com.turfandtaste.app",
  "appName": "Turf & Taste",
  "webDir": "dist",
  "server": {
    "androidScheme": "https"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 2000,
      "launchAutoHide": true,
      "backgroundColor": "#0B0F0B",
      "showSpinner": false,
      "androidScaleType": "CENTER_CROP",
      "splashFullScreen": false,
      "splashImmersive": false
    },
    "StatusBar": {
      "overlays": false,
      "overlaysWebView": false,
      "style": "DARK",
      "backgroundColor": "#090C09"
    }
  }
}
